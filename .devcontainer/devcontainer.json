{
  "name": "ft_ping",
  "image": "mcr.microsoft.com/vscode/devcontainers/cpp:bullseye",
  "remoteUser": "vscode",
  "runArgs": ["--cap-add=NET_RAW"],
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y inetutils-ping",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "eamodio.gitlens"
      ]
    }
  }
}